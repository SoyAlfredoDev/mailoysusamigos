TURSO_AUTH_TOKEN=""
SESSION_SECRET=""
ADMIN_EMAIL="admin@milo.local"
ADMIN_PASSWORD=""
NEXT_PUBLIC_DEMO="true"

# Actualización automática opcional de contenido social (solo servidor).
# Sin estas credenciales se muestra una selección real, verificada y fechada.
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_API_VERSION=""
GOOGLE_PLACE_ID=""
GOOGLE_PLACES_API_KEY=""

# Acceso de clientes: secreto independiente del administrador, mínimo 32 caracteres.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://127.0.0.1:3007"
# En producción usar https://mailoysusamigos.cl y un remitente verificado en Resend.
