generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id          String @id
  name        String
  description String
  category    String
  pet         String
  detail      String
  price       Int
  stock       Int
  image       String
  featured    Boolean @default(false)
  active      Boolean @default(true)
  items       OrderItem[]
}

model Service {
  id          String @id
  name        String
  kind        String
  description String
  price       Int
  duration    Int
  active      Boolean @default(true)
  appointments Appointment[]
}

model Resource {
  id           String @id
  name         String
  kind         String
  active       Boolean @default(true)
  appointments Appointment[]
}

model Customer {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  phone        String
  pets         Pet[]
  appointments Appointment[]
  orders       Order[]
}

model Pet {
  id           String @id @default(cuid())
  name         String
  species      String
  size         String?
  coat         String?
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id         String @id @default(cuid())
  reference  String @unique
  date       String
  time       String
  startAt    DateTime
  endAt      DateTime
  status     String @default("PENDING")
  notes      String @default("")
  price      Int
  serviceId  String
  service    Service @relation(fields: [serviceId], references: [id])
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  petId      String
  pet        Pet @relation(fields: [petId], references: [id])
  createdAt  DateTime @default(now())
  slots      Slot[]
  @@index([date, resourceId])
}

model Slot {
  id            String @id @default(cuid())
  resourceId    String
  startAt       DateTime
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  @@unique([resourceId, startAt])
}

model Order {
  id             String @id @default(cuid())
  reference      String @unique
  idempotencyKey String @unique
  status         String @default("PENDING")
  paymentStatus  String @default("UNPAID")
  total          Int
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  createdAt      DateTime @default(now())
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
}

model LoginAttempt {
  key       String @id
  count     Int @default(0)
  resetAt   DateTime
}
